{
  "name": "Study Group Finder Dev Container",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": true,
      "installGradle": false
    }
  },
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current"
  },
  "forwardPorts": [
    8080
  ],
  "postCreateCommand": "chmod +x mvnw && ./mvnw -q -ntp dependency:go-offline"
}